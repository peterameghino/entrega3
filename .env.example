# Copiar a .env y completar. .env está excluido de Git.

# Proveedor activo: openai | anthropic
LLM_PROVIDER=anthropic

# Modelo (obligatorio). Usar uno al que tu cuenta tenga acceso.
LLM_MODEL=

# API keys: completar solo la del proveedor que vayas a usar.
# Clave de OpenAI (si LLM_PROVIDER=openai):
OPENAI_API_KEY=
# Clave de Anthropic (si LLM_PROVIDER=anthropic):
ANTHROPIC_API_KEY=

# Opcionales (valores por defecto entre paréntesis)
# LLM_TEMPERATURE=      # 0 a 2; vacío = default del proveedor. Anthropic: no soportado
# LLM_MAX_TOKENS=1024   # 1 a 32768
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=3
